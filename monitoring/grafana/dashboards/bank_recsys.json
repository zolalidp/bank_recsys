{
  "uid": "bank-recsys",
  "title": "bank_recsys service",
  "timezone": "browser",
  "refresh": "10s",
  "time": {"from": "now-30m", "to": "now"},
  "schemaVersion": 39,
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "CPU процесса сервиса",
      "gridPos": {"h": 8, "w": 8, "x": 0, "y": 0},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {"defaults": {"unit": "percentunit", "min": 0}, "overrides": []},
      "targets": [
        {
          "refId": "A",
          "expr": "rate(process_cpu_seconds_total{job=\"bank_recsys\"}[1m])",
          "legendFormat": "CPU"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Время обработки запроса (квантили)",
      "gridPos": {"h": 8, "w": 8, "x": 8, "y": 0},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {"defaults": {"unit": "s", "min": 0}, "overrides": []},
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.5, sum by (le) (rate(http_request_duration_seconds_bucket{handler=~\"/recommend.*\"}[1m])))",
          "legendFormat": "p50"
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(http_request_duration_seconds_bucket{handler=~\"/recommend.*\"}[1m])))",
          "legendFormat": "p95"
        },
        {
          "refId": "C",
          "expr": "histogram_quantile(0.99, sum by (le) (rate(http_request_duration_seconds_bucket{handler=~\"/recommend.*\"}[1m])))",
          "legendFormat": "p99"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "RPS по эндпоинтам и статусам",
      "gridPos": {"h": 8, "w": 8, "x": 16, "y": 0},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {"defaults": {"unit": "reqps", "min": 0}, "overrides": []},
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (handler, status) (rate(http_request_duration_seconds_count[1m]))",
          "legendFormat": "{{handler}} {{status}}"
        }
      ]
    },
    {
      "id": 4,
      "type": "bargauge",
      "title": "Самые частые рекомендации (за выбранный период)",
      "gridPos": {"h": 10, "w": 12, "x": 0, "y": 8},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "options": {"orientation": "horizontal", "displayMode": "gradient", "reduceOptions": {"calcs": ["lastNotNull"]}},
      "fieldConfig": {"defaults": {"min": 0}, "overrides": []},
      "targets": [
        {
          "refId": "A",
          "expr": "topk(10, sum by (product) (increase(recommendations_total[$__range])))",
          "legendFormat": "{{product}}",
          "instant": true
        }
      ]
    },
    {
      "id": 5,
      "type": "piechart",
      "title": "Источник выдачи: модель vs холодный старт",
      "gridPos": {"h": 10, "w": 6, "x": 12, "y": 8},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "options": {"reduceOptions": {"calcs": ["lastNotNull"]}, "pieType": "donut"},
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (source) (increase(recommend_requests_total[$__range]))",
          "legendFormat": "{{source}}",
          "instant": true
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Чистое время инференса модели (p95)",
      "gridPos": {"h": 10, "w": 6, "x": 18, "y": 8},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {"defaults": {"unit": "s", "min": 0}, "overrides": []},
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(prediction_seconds_bucket[1m])))",
          "legendFormat": "p95 inference"
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Память процесса (RSS)",
      "gridPos": {"h": 7, "w": 8, "x": 0, "y": 18},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {"defaults": {"unit": "bytes", "min": 0}, "overrides": []},
      "targets": [
        {
          "refId": "A",
          "expr": "process_resident_memory_bytes{job=\"bank_recsys\"}",
          "legendFormat": "RSS"
        }
      ]
    },
    {
      "id": 8,
      "type": "stat",
      "title": "Средняя устарелость снапшота клиента, мес.",
      "gridPos": {"h": 7, "w": 8, "x": 8, "y": 18},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {"defaults": {"unit": "none", "decimals": 2}, "overrides": []},
      "targets": [
        {
          "refId": "A",
          "expr": "sum(increase(client_staleness_months_sum[$__range])) / sum(increase(client_staleness_months_count[$__range]))",
          "instant": true
        }
      ]
    },
    {
      "id": 9,
      "type": "stat",
      "title": "Доля ошибок (не-2xx), %",
      "gridPos": {"h": 7, "w": 8, "x": 16, "y": 18},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 2,
          "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "red", "value": 1}]}
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "100 * (sum(increase(http_request_duration_seconds_count{status!~\"2..\"}[$__range])) or vector(0)) / sum(increase(http_request_duration_seconds_count[$__range]))",
          "instant": true
        }
      ]
    }
  ]
}
